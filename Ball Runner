<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Ball Runner Pro 2D</title>
    <style>
        body { margin: 0; background: #0f172a; color: white; text-align: center; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; overflow: hidden; user-select: none; }
        #gameContainer { position: relative; border: 4px solid #38bdf8; border-radius: 12px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5); overflow: hidden; background: #1e293b; }
        #gameCanvas { display: block; background: linear-gradient(to bottom, #070b19 0%, #1e1b4b 100%); }
        .ui-element { position: absolute; font-weight: bold; pointer-events: none; }
        #scoreBoard { top: 15px; left: 20px; font-size: 22px; color: #38bdf8; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
        #highScoreBoard { top: 15px; right: 20px; font-size: 18px; color: #f59e0b; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
        #controlsHint { bottom: 15px; width: 100%; text-align: center; font-size: 14px; color: #94a3b8; }
    </style>
</head>
<body>

    <div id="gameContainer">
        <div id="scoreBoard" class="ui-element">النقاط: 0</div>
        <div id="highScoreBoard" class="ui-element">أعلى نتيجة: 0</div>
        <canvas id="gameCanvas" width="600" height="360"></canvas>
        <div id="controlsHint" class="ui-element">انقر للقفز • انقر مرتين للقفزة المزدوجة</div>
    </div>

<script>
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");

    let ball = { x: 80, y: 280, radius: 16, velocityY: 0, gravity: 0.7, jumpForce: -13, jumpsLeft: 2, trail: [] };
    let groundY = 310; let gameSpeed = 5; let maxSpeed = 12; let score = 0;
    let highScore = localStorage.getItem("ball_highScore") || 0;
    document.getElementById("highScoreBoard").innerText = "أعلى نتيجة: " + highScore;
    
    let isGameOver = false; let isGameStarted = false;
    let obstacles = []; let platforms = []; let clouds = []; let gameTime = 0;

    let audioCtx = null;
    function initAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
    
    function playSound(freq, type, duration, vol = 0.1) {
        if (!audioCtx) return;
        try {
            let osc = audioCtx.createOscillator(); let gain = audioCtx.createGain();
            osc.type = type; osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
            if(type === 'sawtooth') osc.frequency.exponentialRampToValueAtTime(40, audioCtx.currentTime + duration);
            gain.gain.setValueAtTime(vol, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.start(); osc.stop(audioCtx.currentTime + duration);
        } catch(e) {}
    }

    for (let i = 0; i < 4; i++) {
        clouds.push({ x: Math.random() * 600, y: 30 + Math.random() * 80, size: 20 + Math.random() * 20, speed: 0.2 + Math.random() * 0.3 });
    }

    function spawnObstacleOrPlatform() {
        if (isGameOver || !isGameStarted) return;
        gameTime++;
        if (gameTime % 120 === 0 && Math.random() > 0.4) {
            platforms.push({ x: 650, y: 180 + Math.random() * 50, width: 100, height: 15 });
        }
        if (gameTime % 80 === 0) {
            let type = Math.random();
            if (type < 0.5) { obstacles.push({ type: 'spike', x: 650, y: groundY, width: 24, height: 30 }); }
            else if (type < 0.8) { obstacles.push({ type: 'block', x: 650, y: groundY - 40, width: 20, height: 40 }); }
            else { obstacles.push({ type: 'high_spike', x: 650, y: 150, width: 25, height: 25 }); }
        }
    }
    setInterval(spawnObstacleOrPlatform, 20);
    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let skyGradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
        skyGradient.addColorStop(0, '#020617'); skyGradient.addColorStop(1, '#1e1b4b');
        ctx.fillStyle = skyGradient; ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = "rgba(255, 255, 255, 0.15)";
        clouds.forEach(c => {
            if(!isGameOver && isGameStarted) c.x -= c.speed;
            if (c.x < -60) c.x = 650;
            ctx.beginPath(); ctx.arc(c.x, c.y, c.size, 0, Math.PI * 2);
            ctx.arc(c.x + c.size*0.6, c.y - c.size*0.2, c.size*0.8, 0, Math.PI * 2);
            ctx.arc(c.x + c.size*1.2, c.y, c.size*0.6, 0, Math.PI * 2); ctx.fill();
        });

        ctx.fillStyle = "#1e293b"; ctx.fillRect(0, groundY, canvas.width, canvas.height - groundY);
        ctx.strokeStyle = "#38bdf8"; ctx.lineWidth = 4;
        ctx.beginPath(); ctx.moveTo(0, groundY); ctx.lineTo(canvas.width, groundY); ctx.stroke();

        if (!isGameStarted) {
            ctx.fillStyle = "#38bdf8"; ctx.font = "bold 26px Arial"; ctx.fillText("لعبة Ball Runner Pro", 190, 140);
            ctx.fillStyle = "#ffffff"; ctx.font = "18px Arial"; ctx.fillText("انقر على الشاشة للبدء والقفز", 200, 200);
            requestAnimationFrame(draw); return;
        }

        ball.velocityY += ball.gravity; ball.y += ball.velocityY;
        if (ball.y > groundY - ball.radius) { ball.y = groundY - ball.radius; ball.velocityY = 0; ball.jumpsLeft = 2; }

        platforms.forEach(p => {
            if(!isGameOver) p.x -= gameSpeed;
            if (ball.x + ball.radius > p.x && ball.x - ball.radius < p.x + p.width &&
                ball.y + ball.radius >= p.y && ball.y - ball.radius < p.y && ball.velocityY > 0) {
                ball.y = p.y - ball.radius; ball.velocityY = 0; ball.jumpsLeft = 2;
            }
            ctx.fillStyle = "#0284c7"; ctx.fillRect(p.x, p.y, p.width, p.height);
            ctx.strokeStyle = "#38bdf8"; ctx.lineWidth = 2; ctx.strokeRect(p.x, p.y, p.width, p.height);
        });
        platforms = platforms.filter(p => p.x > -120);

        if (!isGameOver) {
            ball.trail.push({ x: ball.x, y: ball.y }); if (ball.trail.length > 8) ball.trail.shift();
        }
        ball.trail.forEach((t, index) => {
            ctx.fillStyle = `rgba(244, 63, 94, ${0.1 * index})`;
            ctx.beginPath(); ctx.arc(t.x, t.y, ball.radius * (index/8), 0, Math.PI * 2); ctx.fill();
        });

        let ballGrad = ctx.createRadialGradient(ball.x - 4, ball.y - 4, 2, ball.x, ball.y, ball.radius);
        ballGrad.addColorStop(0, '#f43f5e'); ballGrad.addColorStop(1, '#be123c');
        ctx.fillStyle = ballGrad; ctx.beginPath(); ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = "#fff"; ctx.lineWidth = 1.5; ctx.stroke();

        obstacles.forEach(o => {
            if (!isGameOver) o.x -= gameSpeed;
            ctx.fillStyle = "#ef4444"; ctx.shadowBlur = 10; ctx.shadowColor = "#ef4444";
            if (o.type === 'spike') {
                ctx.beginPath(); ctx.moveTo(o.x, o.y); ctx.lineTo(o.x + o.width/2, o.y - o.height); ctx.lineTo(o.x + o.width, o.y); ctx.closePath(); ctx.fill();
            } else if (o.type === 'block') {
                ctx.fillRect(o.x, o.y, o.width, o.height);
                ctx.strokeStyle = "#f87171"; ctx.lineWidth = 2; ctx.strokeRect(o.x, o.y, o.width, o.height);
            } else if (o.type === 'high_spike') {
                ctx.fillStyle = "#a855f7"; ctx.shadowColor = "#a855f7";
                ctx.beginPath(); ctx.moveTo(o.x + o.width/2, o.y); ctx.lineTo(o.x + o.width, o.y + o.height/2); ctx.lineTo(o.x + o.width/2, o.y + o.height); ctx.lineTo(o.x, o.y + o.height/2); ctx.closePath(); ctx.fill();
            }
            ctx.shadowBlur = 0;

            let testX = ball.x; let testY = ball.y;
            if (o.type === 'block') {
                if (ball.x < o.x) testX = o.x; else if (ball.x > o.x + o.width) testX = o.x + o.width;
                if (ball.y < o.y) testY = o.y; else if (ball.y > o.y + o.height) testY = o.y + o.height;
                let distX = ball.x - testX; let distY = ball.y - testY;
                let distance = Math.sqrt((distX * distX) + (distY * distY));
                if (distance <= ball.radius - 2) triggerGameOver();
            } else {
                if (ball.x + ball.radius - 4 > o.x && ball.x - ball.radius + 4 < o.x + o.width &&
                    ball.y + ball.radius - 2 > (o.type === 'high_spike' ? o.y : o.y - o.height) && ball.y - ball.radius + 2 < (o.type === 'high_spike' ? o.y + o.height : o.y)) {
                    triggerGameOver();
                }
            }
        });
        obstacles = obstacles.filter(o => o.x > -50);

        if (!isGameOver) {
            score++; document.getElementById("scoreBoard").innerText = "النقاط: " + Math.floor(score / 5);
            if (score % 350 === 0 && gameSpeed < maxSpeed) { gameSpeed += 0.5; playSound(600, 'sine', 0.08, 0.05); }
        } else {
            ctx.fillStyle = "rgba(15, 23, 42, 0.8)"; ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "#ef4444"; ctx.font = "bold 32px Arial"; ctx.fillText("انتهت اللعبة!", 220, 140);
            ctx.fillStyle = "#ffffff"; ctx.font = "18px Arial"; ctx.fillText("النتيجة النهائية: " + Math.floor(score / 5), 235, 190);
            ctx.fillStyle = "#38bdf8"; ctx.font = "bold 16px Arial"; ctx.fillText("انقر على الشاشة لإعادة المحاولة وتحطيم الرقم القياسي", 130, 240);
        }
        requestAnimationFrame(draw);
    }

    function triggerGameOver() {
        if (isGameOver) return; isGameOver = true; playSound(130, 'sawtooth', 0.6, 0.2);
        let finalScore = Math.floor(score / 5);
        if (finalScore > highScore) {
            highScore = finalScore; localStorage.setItem("ball_highScore", highScore);
            document.getElementById("highScoreBoard").innerText = "أعلى نتيجة: " + highScore;
        }
    }

    window.addEventListener("pointerdown", (e) => {
        initAudio();
        if (!isGameStarted) { isGameStarted = true; playSound(300, 'sine', 0.1, 0.1); return; }
        if (isGameOver) {
            ball.y = 280; ball.velocityY = 0; ball.jumpsLeft = 2; ball.trail = [];
            obstacles = []; platforms = []; gameSpeed = 5; score = 0; gameTime = 0; isGameOver = false;
            playSound(350, 'sine', 0.1, 0.1);
        } else {
            if (ball.jumpsLeft > 0) {
                ball.velocityY = ball.jumpForce; ball.jumpsLeft--;
                let jumpFreq = ball.jumpsLeft === 1 ? 420 : 580; playSound(jumpFreq, 'triangle', 0.12, 0.12);
            }
        }
    });
    draw();
</script>
</body>
</html>
